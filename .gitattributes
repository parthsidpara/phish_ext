# Normalise line endings so files don't get rewritten when the repo is reached
# through the Windows <-> WSL bridge. Without this, committing from Windows
# converts every file to CRLF, which breaks shell scripts on Linux
# (/usr/bin/env bash^M: bad interpreter) and produces diffs where every line
# appears changed.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.svg text eol=lf
